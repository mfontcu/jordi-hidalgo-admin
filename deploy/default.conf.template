# Same SPA and asset caching as the Flutter panel (apps/admin_app/deploy/nginx.conf), plus security
# headers and no caching of index.html. ${API_ORIGIN} comes from the image's build arg.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # add_header in a location replaces the server's, so every location includes the snippet.
    include /etc/nginx/conf.d/snippets/security-headers.conf;

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        expires 1y;
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|webmanifest|woff|woff2)$ {
        expires 30d;
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public";
    }
}
