{
  "name": "jordi-hidalgo-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/app/main.tsx",
    "./src/shared/config/env.ts"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript contract/openapi.json -o src/shared/api/schema.gen.ts",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:import-arb": "node scripts/i18n-import-arb.mjs",
    "icons:generate": "node scripts/icons-generate.mjs",
    "icons:check": "node scripts/icons-generate.mjs --check",
    "budget": "node scripts/bundle-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run api:check && npm run i18n:check && npm run icons:check && npm run test && npm run build:e2e && npm run budget && npm run e2e"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource/roboto": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "libphonenumber-js": "1.13.14",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-intl": "12.1.4",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@material-symbols/svg-400": "0.48.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
